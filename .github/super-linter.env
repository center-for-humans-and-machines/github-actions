# Super-Linter configuration for CI (.github/workflows/super-linter.yml).
# GitHub Actions cannot parse comments in GITHUB_ENV, so the workflow strips
# lines starting with `#`. Do not use trailing comments.
#
# Every VALIDATE_X below has a matching hook in .pre-commit-config.yaml that
# reads the same config file. Setting any VALIDATE_X=true disables all
# validators not listed here.
DEFAULT_BRANCH=main
VALIDATE_ALL_CODEBASE=true
LINTER_RULES_PATH=.
EDITORCONFIG_FILE_NAME=.editorconfig-checker.json
GITHUB_ACTIONS_CONFIG_FILE=.github/actionlint.yml
MARKDOWN_CONFIG_FILE=.markdownlint.yml
YAML_CONFIG_FILE=.yamllint.yml
VALIDATE_EDITORCONFIG=true
VALIDATE_GIT_MERGE_CONFLICT_MARKERS=true
VALIDATE_GITHUB_ACTIONS=true
VALIDATE_GITHUB_ACTIONS_ZIZMOR=true
VALIDATE_GITLEAKS=true
VALIDATE_MARKDOWN=true
VALIDATE_MARKDOWN_PRETTIER=true
VALIDATE_YAML=true
VALIDATE_YAML_PRETTIER=true
